{
  "name": "wgit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc --noEmit && vite build --minify false --mode development",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "typecheck": "vue-tsc --noEmit",
    "test": "bun test tests",
    "preview": "vite preview",
    "audit": "node e2e/run-audit.cjs",
    "audit:contrast": "node e2e/contrast.cjs",
    "audit:popovers": "node e2e/popovers.cjs",
    "audit:smoke": "node e2e/smoke.cjs",
    "audit:responsive": "node e2e/responsive.cjs",
    "audit:content-layout": "node e2e/content-layout.cjs",
    "audit:workspace-layout": "node e2e/workspace-layout.cjs",
    "shots": "node e2e/shots.cjs",
    "shots:check": "node e2e/shots.cjs -- --check",
    "shots:states": "node e2e/shots.cjs -- --only=states",
    "shots:states:check": "node e2e/shots.cjs -- --check --only=states",
    "audit:ai": "node e2e/ai.cjs",
    "audit:ai:baseline": "AI_VISUAL_UPDATE=1 node e2e/ai.cjs"
  },
  "dependencies": {
    "@wailsio/runtime": "^3.0.0-beta.32",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide": "^1.58.0",
    "lucide-vue-next": "^1.0.0",
    "prismjs": "^1.30.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
